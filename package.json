{
  "name": "pirate-battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "convert:atlas": "node scripts/convert-atlas.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report docs/test-report",
    "test:e2e:docker": "bash scripts/playwright-docker.sh",
    "lockfile:linux": "bash scripts/lockfile-linux.sh",
    "profile": "node scripts/profile.mjs"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "axios": "^1.21.1",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "msw": "^3.0.7",
    "oxlint": "^1.95.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
}
